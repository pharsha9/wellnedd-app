generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  hashedPassword      String
  role                Role                @default(USER)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  points              Int                 @default(0)
  ageRange            String?
  gender              Gender?
  location            String?
  occupation          String?
  interests           Json?
  primaryGoals        Json?
  appointmentsAsCoach Appointment[]       @relation("AppointmentCoach")
  appointmentsAsUser  Appointment[]       @relation("AppointmentUser")
  engagementEvents    EngagementEvent[]
  goals               Goal[]
  habits              Habit[]
  journalEntries      JournalEntry[]
  receivedMessages    Message[]           @relation("MessageRecipient")
  sentMessages        Message[]           @relation("MessageSender")
  enrollments         ProgramEnrollment[]
  userRewards         UserReward[]
  checkIns            WellnessCheckIn[]

  @@index([role])
}

model WellnessCheckIn {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  mood            Int
  stressLevel     Int
  energyLevel     Int
  sleepHours      Float
  sleepQuality    Int
  activityMinutes Int
  notes           String?
  tags            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Habit {
  id              String        @id @default(cuid())
  userId          String
  name            String
  description     String?
  category        HabitCategory
  targetFrequency Int
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs            HabitLog[]

  @@index([userId, active])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(false)
  value     Float?
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model Goal {
  id            String        @id @default(cuid())
  userId        String
  title         String
  description   String?
  category      HabitCategory
  startDate     DateTime
  targetDate    DateTime
  status        GoalStatus    @default(ACTIVE)
  targetMetric  String
  baselineValue Float
  targetValue   Float
  currentValue  Float
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Program {
  id                     String              @id @default(cuid())
  title                  String
  slug                   String              @unique
  description            String
  category               ProgramCategory
  estimatedDurationWeeks Int
  difficulty             ProgramDifficulty
  isPublic               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  enrollments            ProgramEnrollment[]
  modules                ProgramModule[]
}

model ProgramModule {
  id        String              @id @default(cuid())
  programId String
  title     String
  order     Int
  summary   String
  progress  ProgramEnrollment[] @relation("CurrentModule")
  lessons   ProgramLesson[]
  program   Program             @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, order])
}

model ProgramLesson {
  id       String              @id @default(cuid())
  moduleId String
  title    String
  order    Int
  content  String
  mediaUrl String?
  progress ProgramEnrollment[] @relation("CurrentLesson")
  module   ProgramModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
}

model ProgramEnrollment {
  id              String         @id @default(cuid())
  userId          String
  programId       String
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  progressPercent Int            @default(0)
  currentModuleId String?
  currentLessonId String?
  currentLesson   ProgramLesson? @relation("CurrentLesson", fields: [currentLessonId], references: [id])
  currentModule   ProgramModule? @relation("CurrentModule", fields: [currentModuleId], references: [id])
  program         Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId])
}

model ContentItem {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  type            ContentType
  body            String
  mediaUrl        String?
  durationMinutes Int?
  tags            Json?
  published       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  coachId     String
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  mode        AppointmentMode
  notes       String?
  coach       User              @relation("AppointmentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  user        User              @relation("AppointmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([coachId, scheduledAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  recipientId    String
  content        String
  sentAt         DateTime  @default(now())
  readAt         DateTime?
  recipient      User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender         User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

model EngagementEvent {
  id         String         @id @default(cuid())
  userId     String
  type       EngagementType
  entityType String?
  entityId   String?
  timestamp  DateTime       @default(now())
  metadata   Json?
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([type, timestamp])
}

model Reward {
  id          String       @id @default(cuid())
  name        String
  description String
  pointsCost  Int
  active      Boolean      @default(true)
  redemptions UserReward[]
}

model UserReward {
  id         String   @id @default(cuid())
  userId     String
  rewardId   String
  redeemedAt DateTime @default(now())
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, redeemedAt])
}

model JournalEntry {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @default(now())
  content          String
  moodAnalysis     Json?
  recommendedSteps Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

enum Role {
  USER
  COACH
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum HabitCategory {
  MINDFULNESS
  SLEEP
  NUTRITION
  ACTIVITY
  OTHER
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ON_HOLD
  CANCELLED
}

enum ProgramCategory {
  STRESS
  SLEEP
  NUTRITION
  ACTIVITY
  GENERAL_WELLNESS
}

enum ProgramDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  ARTICLE
  VIDEO
  AUDIO
  EXERCISE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AppointmentMode {
  VIDEO
  CHAT
  PHONE
}

enum EngagementType {
  LOGIN
  CHECKIN_CREATED
  HABIT_COMPLETED
  PROGRAM_PROGRESS
  CONTENT_VIEWED
  JOURNAL_ANALYZED
}
